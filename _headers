/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Static, content-stable assets (a changed asset should get a new filename or
# a ?v query) can be cached hard and immutable.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

/assets/icons/*
  Cache-Control: public, max-age=31536000, immutable

/assets/logos/*
  Cache-Control: public, max-age=31536000, immutable

# styles.css and nav.js keep stable, unversioned URLs, so they must NOT be
# immutable — otherwise a deploy ships new HTML against a year-old cached
# stylesheet/script (unstyled elements, broken layout). Revalidate every load
# (cheap 304 via ETag). We also bump a ?v= query in the HTML on each deploy as
# a belt-and-suspenders cache-bust.
/assets/styles.css
  Cache-Control: public, max-age=0, must-revalidate

/assets/nav.js
  Cache-Control: public, max-age=0, must-revalidate
